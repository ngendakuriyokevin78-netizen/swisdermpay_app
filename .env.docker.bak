# ============================================================
# Cash Tel — Variables d'environnement (exemple)
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================================

# ── Django ──────────────────────────────────────────────────
SECRET_KEY=change-moi-en-production-clef-secrete-tres-longue
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# ── Base de données PostgreSQL ──────────────────────────────
DATABASE_URL=postgres://cashtel:cashtel_password@db:5432/cashtel
POSTGRES_DB=cashtel
POSTGRES_USER=cashtel
POSTGRES_PASSWORD=cashtel_password

# ── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS (séparer par virgule) ──────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Service SMS ─────────────────────────────────────────────
# 'mock' = affiche dans les logs (développement)
# 'africastalking' = envoi réel via Africa's Talking
SMS_BACKEND=mock
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=CashTel

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Règles métier ────────────────────────────────────────────
MAX_PIN_ATTEMPTS=3
OTP_EXPIRY_MINUTES=10
MIN_TRANSFER_AMOUNT=100
